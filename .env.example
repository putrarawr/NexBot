# Port untuk Web Dashboard & API (sesuaikan dengan port Serv00 yang kamu dapat dari: devil port add tcp random)
PORT=3000

# Password / PIN Admin untuk login ke Web Dashboard
ADMIN_PASSWORD=admin123

# Nama Bot WhatsApp & Prefix Command
BOT_NAME=NexBot
PREFIX=.

# Nomor WhatsApp Pemilik (format internasional tanpa +, e.g. 6281234567890)
OWNER_NUMBER=628123456789

# API Key AI Opsional (Bisa dikosongkan! Bot tetap jalan dengan free AI fallback)
# Dapatkan gratis di: https://console.groq.com/keys
GROQ_API_KEY=

# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
